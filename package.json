{
  "name": "sugar-high-monorepo",
  "private": true,
  "description": "Monorepo for Sugar High packages",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm -r run dev",
    "clean": "pnpm -r run clean",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build",
    "check:packages": "node scripts/check-packages.mjs",
    "release-video:studio": "pnpm --filter release-video dev",
    "release-video:render": "pnpm --filter release-video render",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm test && pnpm build && changeset publish"
  },
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "author": "huozhi",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "next": "^16.3.0"
  }
}
