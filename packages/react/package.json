{
  "name": "@sugar-high/react",
  "version": "0.1.0",
  "description": "Lightweight React code blocks and editors powered by Sugar High",
  "author": "huozhi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huozhi/sugar-high.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "default": "./dist/code/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "test": "vitest --run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "sugar-high": ">=2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "bunchee": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sugar-high": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
