{
  "name": "sugar-high",
  "version": "2.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huozhi/sugar-high.git",
    "directory": "packages/sugar-high"
  },
  "type": "module",
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "default": "./lib/core.js"
    },
    "./lang": {
      "types": "./lib/lang.d.ts",
      "default": "./lib/lang.js"
    },
    "./lang/*": {
      "types": "./lib/lang/*.d.ts",
      "default": "./lib/lang/*.js"
    }
  },
  "description": "Lightweight, zero-dependency syntax highlighting for popular programming languages",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest",
    "build": "echo 'package requires no build'",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "typescript": "6.0.2",
    "vitest": "^3.0.2"
  }
}
